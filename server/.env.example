PORT=4000

# 管理后台登录账号密码（必须修改，否则登录会一直失败）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# 管理后台访问路径，默认 /admin，改成不容易被猜到的路径更安全
# 改了之后访问地址就是 https://你的域名/ADMIN_PATH/index.html
ADMIN_PATH=admin

# 你的完整访问域名（用于Bark推送里生成"点击跳转到后台"的链接，不填就只是普通推送，点开不会自动跳转）
PUBLIC_URL=https://chat.yourdomain.com

# Web Push 原生推送用的密钥对，一次性生成，生成方法见 README
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 从Crisp导入历史会话时用（只在跑 scripts/import-crisp.js 这个一次性脚本时需要，
# 平时不用管这几行，获取方法见README"从Crisp导入历史会话"章节）
CRISP_WEBSITE_ID=
CRISP_TOKEN_ID=
CRISP_TOKEN_KEY=
